# fnOS VM test harness — connection + options.
# Copy to config.env (git-ignored) and adjust for your VM.

# --- fnOS test VM (see README.md "Provisioning the VM") ---
FNOS_VM_IP="10.211.55.x"          # VM IP (Parallels shared net → parallels_dhcp_leases)
FNOS_VM_USER="fnadmin"            # the fnOS super-admin you created
FNOS_VM_PASS="CHANGE_ME"          # real value goes in config.env (git-ignored) — never commit it

# fnOS storage-space index to install into (a real /volN, e.g. 1 or 2).
FNOS_TEST_VOLUME="1"

# .fpk architecture — must match the VM's CPU.
FNOS_ARCH="x86"                   # x86 | arm

# GitHub download mirror prefix for .fpk (empty = direct GitHub).
# ghfast.top mirrors what the store uses; helps from mainland China.
FNOS_MIRROR="https://ghfast.top/"

# Per-app waits (seconds).
FNOS_START_TIMEOUT="40"           # wait for appcenter-cli status = running
FNOS_PORT_TIMEOUT="30"            # wait for the service port to accept TCP
