#!/bin/sh
# 自用签到 配置变更初始化：应用中心「应用设置」已无可配置业务字段
# （全部配置已迁移到应用内页面）。保留回调框架，仅记录调用。
set -u

VAR_DIR="${TRIM_PKGVAR:-/vol1/@appdata/checkin}"
LOG_FILE="${VAR_DIR}/info.log"
mkdir -p "${VAR_DIR}"

log_msg() {
    local msg="$(date '+%Y-%m-%d %H:%M:%S') - [config_init] $1"
    echo "$msg"
    echo "$msg" >> "${LOG_FILE}" 2>/dev/null || true
}

log_msg "=== config_init start ==="
log_msg "配置已全部迁移到应用内页面，忽略应用设置回调"
log_msg "=== config_init end ==="
exit 0