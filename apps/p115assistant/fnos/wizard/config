[
  {
    "stepTitle": "运行配置",
    "items": [
      {
        "type": "switch",
        "field": "enabled",
        "label": "启用",
        "default": false,
        "tips": "关闭后后端不再执行登录、上传与签到任务。"
      },
      {
        "type": "select",
        "field": "rate_limit_profile",
        "label": "限流档位",
        "default": "balanced",
        "options": [
          {
            "label": "保守",
            "value": "conservative"
          },
          {
            "label": "均衡（推荐）",
            "value": "balanced"
          },
          {
            "label": "激进",
            "value": "fast"
          }
        ],
        "tips": "限流档位：请求级限速（115 接口访问频率），控制整体 API 调用节奏。"
      }
    ]
  },
  {
    "stepTitle": "上传",
    "items": [
      {
        "type": "switch",
        "field": "upload_include_sidecars",
        "label": "上传附属文件",
        "default": true,
        "tips": "同时上传 nfo/jpg/srt/ass 等附属文件。"
      },
      {
        "type": "switch",
        "field": "upload_generate_strm",
        "label": "上传后生成 STRM",
        "default": false,
        "tips": "上传完成后为文件生成 STRM 占位。"
      },
      {
        "type": "switch",
        "field": "upload_delete_source",
        "label": "上传后删除源文件",
        "default": false,
        "tips": "上传成功后删除本地源文件。"
      },
      {
        "type": "select",
        "field": "upload_conflict_policy",
        "label": "上传身份冲突",
        "default": "ask",
        "options": [
          {
            "label": "先询问（挂清单）",
            "value": "ask"
          },
          {
            "label": "采用远端",
            "value": "adopt"
          },
          {
            "label": "重传覆盖",
            "value": "reupload"
          }
        ]
      },
      {
        "type": "select",
        "field": "upload_risk_profile",
        "label": "上传风控策略",
        "default": "conservative",
        "options": [
          {
            "label": "保守（每文件6s/每批5个）",
            "value": "conservative"
          },
          {
            "label": "平衡（每文件3s/每批10个）",
            "value": "balanced"
          },
          {
            "label": "激进（每文件1.5s/每批20个）",
            "value": "aggressive"
          }
        ],
        "tips": "上传风控档位：上传任务节流（并发与批次），控制单次上传压力；与「限流档位」分工不同，两者独立设置。"
      }
    ]
  },
  {
    "stepTitle": "STRM",
    "items": [
      {
        "type": "text",
        "field": "relay_port",
        "label": "播放中转端口",
        "default": "3667",
        "rules": [
          {
            "pattern": "^[0-9]{2,5}$",
            "message": "端口为数字，如 3667"
          }
        ],
        "tips": "302 播放中转端口：STRM 文件中的直连端口，播放器通过该端口匿名取链（默认 3667）。"
      }
    ]
  },
  {
    "stepTitle": "签到",
    "items": [
      {
        "type": "switch",
        "field": "checkin_enabled",
        "label": "每日签到",
        "default": false
      },
      {
        "type": "text",
        "field": "checkin_time_range",
        "label": "签到时段",
        "default": "06:00-09:00",
        "rules": [
          {
            "pattern": "^[0-9]{2}:[0-9]{2}-[0-9]{2}:[0-9]{2}$",
            "message": "格式如 06:00-09:00"
          }
        ]
      },
      {
        "type": "switch",
        "field": "checkin_notify",
        "label": "签到结果通知",
        "default": false,
        "tips": "签到完成后通过飞书通知结果。"
      }
    ]
  },
  {
    "stepTitle": "飞书通知（可选）",
    "items": [
      {
        "type": "switch",
        "field": "feishu_enabled",
        "label": "启用飞书通知",
        "default": false
      },
      {
        "type": "password",
        "field": "feishu_webhook",
        "label": "飞书机器人 Webhook",
        "tips": "https://open.feishu.cn 自定义机器人 webhook。启用后签到、上传完成会推送通知。"
      }
    ]
  }
]